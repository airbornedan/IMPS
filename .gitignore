# IMPS — secrets & real credentials.
imps_config.toml
deploy/reset_credentials.toml
deploy/mail_credentials.toml

# Docker secrets (real values; .env.example is the tracked template)
.env

# Session-signing secret (regenerated automatically on first run)
.secret_key

# Install-state markers (generated per-install, not source)
not_first.run

# Demo-hosting-only tooling (airbornedan's public demo instance —
# auto-reset + monitoring — not needed for a private install)
deploy/imps_reset.py
deploy/db_monitor.py
deploy/mail_credentials_example.toml
deploy/reset_credentials_example.toml
deploy/.db_monitor_state.toml
deploy/.imps_reset.lock
deploy/maintenance.flag
deploy/MAINTENANCE
deploy/tools/imps-reset.service
deploy/tools/imps-reset.timer
deploy/tools/imps-db-monitor.service
deploy/tools/imps-db-monitor.timer
deploy/tools/mysql-restart-override.conf

# Runtime data that differs per deployment (home/demo/local)
static/images/items/*
!static/images/items/none.jpg

# Generated and saved QR codes
static/images/qrcodes/*

# Generated DB/photo backups -- schema.sql and setup.sql now live in
# deploy/ as source, so everything left in here is purely runtime output
static/backup/*
!static/backup/.gitkeep

# ===================================================================
# Python
# ===================================================================
__pycache__/

# Virtual environments
.venv/
