# Keep this file beside docker-compose.yml, named .env.

# Your server's LAN address or hostname; used in box QR codes.
# Do not use localhost, 127.0.0.1 or a container address.
# Include the port when IMPS_PORT is not 80, e.g. 192.168.1.50:8080.
IMPS_IP=192.168.1.50

# Browser port on your server. Use 8080 if port 80 is already occupied.
IMPS_PORT=80

# Replace with a strong password for MariaDB administration.
MARIADB_ROOT_PASSWORD=change-me-root

# Replace with a different strong password for IMPS database access.
# These database passwords are separate from the browser login set during setup.
IMPS_DB_PASSWORD=change-me-imps

# Optional text beside "IMPS" in the page header. Leave blank for no label.
IMPS_LABEL=
