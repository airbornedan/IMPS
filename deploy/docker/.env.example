# LAN address other devices use to reach IMPS; printed into box QR codes.
# Add the port if IMPS_PORT isn't 80, e.g. 192.168.1.50:8080
IMPS_IP=192.168.1.50
# Host port for the web UI
IMPS_PORT=80
# Pick your own strong values; only the two containers use them.
MARIADB_ROOT_PASSWORD=change-me-root
IMPS_DB_PASSWORD=change-me-imps
# Optional label shown next to "IMPS" in the header
IMPS_LABEL=
