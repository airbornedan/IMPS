[Unit]
Description=Check IMPS database connectivity and email on prolonged outage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/getimps.com/demo/deploy
ExecStart=/usr/bin/python3 /var/www/getimps.com/demo/deploy/db_monitor.py

# Same hardening spirit as the other IMPS deploy scripts.
ProtectSystem=strict
ReadWritePaths=/var/www/getimps.com/demo/deploy
NoNewPrivileges=true
PrivateTmp=true
