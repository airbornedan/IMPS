[Unit]
Description=Reset IMPS demo database and images to seed state
Wants=network-online.target
After=mysql.service mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/getimps.com/demo
ExecStart=/usr/bin/python3 /var/www/getimps.com/demo/deploy/imps_reset.py

# Hardening -- same spirit as the app service itself
ProtectSystem=strict
ReadWritePaths=/var/www/getimps.com/demo /tmp
NoNewPrivileges=true
PrivateTmp=true
