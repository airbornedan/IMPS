# imps_config.toml
#
# Copy this file to imps_config.toml and fill in real values before
# running IMPS.

[database]
# Settings for the IMPS DB

# IP address of database host in the form "nnn.nnn.nnn.nnn"
# If IMPS and the DB are hosted on the same server, use "127.0.0.1"
host = "127.0.0.1"

# Database name
name = "box_db"

# DB user with permissions on named DB
user = "box_user"

# Password for DB user
password = "box_pass"

[directories]
# Settings for the IMPS app

# IP address of the server running IMPS in the form "nnn.nnn.nnn.nnn"
imps_ip = "127.0.0.1"

# Absolute path to the directory IMPS is installed in (the same
# directory this file is in).
imps_dir = "/var/www/"

# Path (relative to imps_dir) where IMPS stores item images.
item_image_dir = "static/images/items/"

# Path (relative to imps_dir) where IMPS stores database and photo
# backups.
backup_dir = "static/backup"

[password]
# Settings for the IMPS app
password = "imps"

[instance]
# Optional. Shown next to "IMPS" in the page header and browser tab
# title -- useful for telling installs apart at a glance when more
# than one is running (a demo, a real install, a disposable test
# VM, etc.). Leave blank, or omit this whole section, for no label.
label = ""

# [rate_limit]
# Optional. Controls where login-attempt counts (see app/blueprints/auth.py)
# are tracked. Uncomment and set this if IMPS is served by more than one
# worker process.
# storage_uri = "redis://127.0.0.1:6379"

# [access]
# Optional. Restricts IMPS to your home LAN, rejecting any connection
# from outside it. Off by default -- leave this whole section out (or
# leave restrict_to_lan = false) unless you specifically want this.
#
# DO NOT ENABLE THIS if you're running IMPS via the Docker Compose
# setup (deploy/docker) or behind any reverse proxy: in both cases
# IMPS sees the proxy/container's address instead of the real client
# address, so this would either lock everyone out or do nothing.
# It's only meaningful for the plain Apache/mod_wsgi deploy, where
# IMPS talks to clients directly.
#
# restrict_to_lan = false
#
# Your own IP address on the LAN (the same address you'd put in
# [directories] imps_ip above, or whatever your router/OS shows as
# this machine's local IP). IMPS assumes a standard /24 home network
# around that address (e.g. "192.168.0.42" allows 192.168.0.1 through
#192.168.0.254) -- that covers the default setup on virtually every
# home router.
#
# Advanced: if your network isn't a plain /24, add the prefix length
# yourself, e.g. lan_ip = "192.168.0.42/16".
#
# lan_ip = ""
